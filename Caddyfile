# =============================================================================
# Student CRM — Caddyfile (Production)
# =============================================================================
# Lives in the server (API) repo since it's VPS/ops config, but it fronts
# both apps, which now live in two independently-cloned repos on the VPS:
#   - elle.isseylab.com  -> static SPA build from the client repo
#     (https://github.com/isseygino911/elle_f.git), served directly by Caddy
#   - api.isseylab.com   -> reverse proxy to this repo's Express API
#     (Docker-composed or PM2-managed, see DEPLOY.md)
#
# Automatic HTTPS: Caddy obtains/renews TLS certs automatically for both
# domains below with no manual cert directives needed, reusing the existing
# Caddy automatic-TLS pattern already in use on the VPS.
#
# {$PORT} must match the `PORT` value in this repo's production `.env` (see
# .env.example; default is 4000). Caddy reads {$PORT} from its own process
# environment, so export PORT on the VPS (or hardcode the number below) to
# keep it in sync with the Express server's PORT.
# =============================================================================

api.isseylab.com {
	reverse_proxy localhost:{$PORT}
}

elle.isseylab.com {
	# Replace with the absolute path to `dist/` inside wherever the client
	# repo is cloned on this VPS (e.g. /var/www/elle_f/dist) — it is NOT a
	# sibling directory of this repo anymore now that client/server are
	# split.
	root * /path/to/elle_f/dist
	file_server
	try_files {path} /index.html
}
