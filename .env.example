# =============================================================================
# Student CRM — API Environment Variable Contract
# =============================================================================
# Copy this file to `.env` (this same directory) and fill in real values
# there. `.env` is the single source of truth for these vars.
# NEVER commit the real .env file — it is gitignored. This file documents
# NAMES and PURPOSE only; no real secrets belong here, ever.
# =============================================================================

# --- Server ---
NODE_ENV=development
# Port the Express API listens on (dev + prod behind Caddy reverse proxy).
PORT=4000

# --- CORS ---
# Single allowed client origin (scheme + host + port, no trailing slash).
# Dev default matches the Vite dev server. Production value is the real
# client domain served by Caddy: https://elle.isseylab.com
# No wildcards, no multi-origin list.
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
# Local dev: matches docker-compose.dev.yml. Prod: native MySQL on the VPS.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_crm
DB_USER=student_crm_app
DB_PASSWORD=
# Only used by docker-compose.dev.yml to set the MySQL root password locally.
DB_ROOT_PASSWORD=

# --- JWT (RS256) ---
# Do NOT generate or commit real keys. Generate a local dev keypair with:
#   openssl genrsa -out keys/jwt_private.pem 2048
#   openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
# The keys/ directory and *.pem/*.key files are gitignored — never commit them.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- AWS S3 — video/file storage ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- SMTP / Gmail — outbound mail (password reset links) ---
# OPTIONAL. The API boots and runs without these. When SMTP_USER and
# SMTP_PASSWORD are both empty, password reset still works end to end but the
# link is written to the server console instead of emailed (and in
# NODE_ENV=production it is silently skipped rather than logged, so a live
# reset credential never lands in production logs).
#
# GMAIL REQUIRES AN APP PASSWORD — a normal account password will be
# rejected, and App Passwords require 2-Step Verification to be on:
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
#      (choose "Mail" / "Other", name it e.g. "Elle API")
#   3. Paste the 16-character value into SMTP_PASSWORD below. Google shows it
#      as four groups of four — the spaces are cosmetic and are stripped.
#
# An App Password grants full send access to this mailbox. Treat it exactly
# like any other secret: it belongs only in .env, which is gitignored.
#
# Verify credentials without sending mail:  npm run check:mail
#
# Gmail's free tier caps sending at roughly 500 recipients/day. Fine for
# password resets; switch to a transactional provider before bulk mail.
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (default), 465 = implicit TLS. The code derives which to use
# from this number, so don't set one expecting the other.
SMTP_PORT=587
# The full Gmail address, e.g. elle.studio@gmail.com
SMTP_USER=
# The 16-character App Password from step 2 above — NOT the account password.
SMTP_PASSWORD=
# What recipients see in the From: header. Defaults to SMTP_USER when blank.
# Gmail rejects a From: that isn't the authenticated account or a verified
# alias, so a display-name form is the useful case here:
#   MAIL_FROM="Elle <elle.studio@gmail.com>"
MAIL_FROM=

# --- Jitsi Meet — video sessions ---
# helmet's default Content-Security-Policy is used as a placeholder — there
# is no explicit connect-src allowlist yet. An explicit CSP with the Jitsi
# and S3 origins will need to be added when those integrations land.
JITSI_DOMAIN=
