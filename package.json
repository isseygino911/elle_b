{
  "name": "student-crm-server",
  "version": "1.0.0",
  "private": true,
  "description": "Student CRM Express API server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "local": "npm run db:up && ENV_FILE=.env.dev nodemon src/index.js",
    "seed:dev": "DEV_ENV_FILE=./.env.dev node scripts/seed-dev.js",
    "migrate": "node migrations/run.js",
    "seed:elle": "node scripts/seed-elle.js",
    "seed:owner": "node scripts/seed-owner.js",
    "check:mail": "node scripts/check-mail.js",
    "test": "node --import ./test/preload.js --test \"test/**/*.test.js\"",
    "test:watch": "node --import ./test/preload.js --test --watch \"test/**/*.test.js\"",
    "db:up": "docker compose --env-file ./.env.local.db -f docker-compose.dev.yml up -d",
    "db:down": "docker compose --env-file ./.env.local.db -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-presigned-post": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.9.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.10.0",
    "nodemailer": "^9.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "nodemon": "^3.1.14"
  }
}
